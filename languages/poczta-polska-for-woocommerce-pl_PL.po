#. Plugin Name of the plugin
#: poczta-polska-for-woocommerce.php
#: src/Privacy.php:43
msgid "Poczta Polska for WooCommerce"
msgstr "Poczta Polska for WooCommerce"

#. Description of the plugin
#: poczta-polska-for-woocommerce.php
msgid "Pocztex and eCommerce shipping methods with the Poczta Polska pickup point map, cash on delivery and shipment handling in Elektroniczny Nadawca (EN)."
msgstr "Metody dostawy Pocztex i eCommerce z mapą punktów odbioru Poczty Polskiej, płatnością przy odbiorze i obsługą przesyłek w Elektronicznym Nadawcy (EN)."

#. Author of the plugin
#: poczta-polska-for-woocommerce.php
msgid "Web Systems"
msgstr "Web Systems"

#. Author URI of the plugin
#: poczta-polska-for-woocommerce.php
msgid "https://web-systems.pl"
msgstr "https://web-systems.pl"

#. translators: 1: required PHP version, 2: current PHP version.
#: poczta-polska-for-woocommerce.php:55
#, php-format
msgid "Poczta Polska for WooCommerce requires PHP %1$s or newer. This server runs PHP %2$s, so the plugin is inactive."
msgstr "Poczta Polska for WooCommerce wymaga PHP %1$s lub nowszego. Ten serwer ma PHP %2$s, więc wtyczka nie działa."

